    "/api/analytics/quality-cost": {
      "get": {
        "summary": "Quality Cost",
        "description": "All scored providers in one specialty, raw mean costs and SQL cohort means.\n\nHighlight means strictly below mean cost AND above mean heuristic score.\nUnknown specialties return an empty cohort, not a cross-specialty fallback.",
        "operationId": "quality_cost_api_analytics_quality_cost_get",
        "parameters": [
          {
            "name": "specialty",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50,
              "default": "Cardiology",
              "title": "Specialty"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QualityCost"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/analytics/evidence": {
      "get": {
        "summary": "Evidence",
        "description": "Disjoint eligibility counts and exact completeness bins across all providers.\n\nInsufficient outcomes takes precedence over low completeness. Zero encounters\nhave undefined completeness. Missing score rows are reported as not processed.",
        "operationId": "evidence_api_analytics_evidence_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Evidence"
                }
              }
            }
          }
        }
      }
    },
