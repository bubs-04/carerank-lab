# Run python scripts/setup_env.py to generate a local password.
POSTGRES_PASSWORD=replace_with_random_local_password
# For native development, supply a PostgreSQL URI in your shell:
# export DATABASE_URL='postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/carerank'

# Optional monitoring thresholds. Existing .env files need no changes.
# Each changed threshold creates a distinct recorded rule configuration.
# DQ_ENABLED=true
# DQ_REJECTED_PERCENT=5
# DQ_MISSING_PERCENT=5
# DQ_DUPLICATE_PERCENT=1
# DQ_WARNING_RATE_CHANGE=10
# DQ_ACCEPTED_CHANGE_PERCENT=20
# DQ_MEMBERSHIP_PERCENT=25

# Secure defaults. No default user account or password is created.
# Local HTTP development only: explicitly opt out of Secure cookies.
# APP_ENV=development
# AUTH_COOKIE_SECURE=false
# Production requires HTTPS and exact trusted browser origins.
# AUTH_SESSION_SECONDS=28800
# AUTH_ALLOWED_ORIGINS=http://localhost:8080
