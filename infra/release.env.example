# Non-secret release manifest. Replace every placeholder; never add DB passwords here.
BACKEND_IMAGE=123456789012.dkr.ecr.us-east-1.amazonaws.com/carerank/backend@sha256:REPLACE_WITH_64_HEX_DIGEST
WEB_IMAGE=123456789012.dkr.ecr.us-east-1.amazonaws.com/carerank/web@sha256:REPLACE_WITH_64_HEX_DIGEST
PUBLIC_ORIGIN=https://carerank.example.org
WEB_BIND_ADDRESS=10.64.0.10
AWS_REGION=us-east-1
AWS_LOG_GROUP=/carerank/REPLACE_WITH_STACK_NAME
RELEASE_ID=REPLACE_WITH_GIT_COMMIT_SHA
WORKER_INSTANCE_ID=production-worker-1
SECRET_DIR=/run/carerank-secrets
RDS_CA_FILE=/etc/carerank/global-bundle.pem
RDS_CA_SHA256=REPLACE_WITH_APPROVED_64_HEX_CHECKSUM
